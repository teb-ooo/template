# Per-app playground settings. `playground new` sets gpu/assistant from its flags (--gpu, --assistant).
name: {{name}}
description: "{{description}}"
subdomain: {{subdomain}}
gpu: false          # true gives the containers the shared AMD GPU (BOOTSTRAP 4.5)
assistant: false    # true adds the end-user assistant at /assistant (only when brain/docs/spec.md says a chat would help)
