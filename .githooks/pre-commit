#!/usr/bin/env bash
# Blocks a commit that stages a secret. `playground new` points core.hooksPath at .githooks.
set -euo pipefail
command -v gitleaks >/dev/null || { echo "pre-commit: gitleaks is not installed" >&2; exit 1; }
cfg="$(git rev-parse --show-toplevel)/.gitleaks.toml"
gitleaks git --pre-commit --staged --redact --no-banner --config "$cfg" \
  || { echo "pre-commit: possible secret staged (values are redacted above). Remove it and rotate it with 'playground secrets set'; never commit secrets." >&2; exit 1; }
