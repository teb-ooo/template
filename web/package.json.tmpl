{
  "name": "{{name}}-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "gen:api": "(cd .. && go run ./cmd/server --print-openapi > web/src/api/openapi.json) && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:e2e": "playwright test",
    "gen:routes": "tsr generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@teb-ooo/ui": "{{ui_version}}",
    "@teb-ooo/web": "{{web_version}}",
    "lucide-react": "^1.0.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tanstack/router-plugin": "^1.168.38",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "@tanstack/router-cli": "^1.167.36"
  },
  "overrides": {
    "openapi-typescript": { "typescript": "$typescript" }
  }
}
