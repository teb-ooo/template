{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "unicorn", "oxc", "import"],
  "env": { "browser": true, "es2023": true },
  "categories": { "correctness": "error", "suspicious": "warn" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "import/no-unassigned-import": "off",
    "no-underscore-dangle": "off",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "jsx-a11y/no-autofocus": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["test/**", "e2e/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": { "typescript/no-non-null-assertion": "off" }
    },
    {
      // Playwright fixtures call a callback named `use`; it is not a React hook
      "files": ["e2e/**"],
      "rules": { "react/rules-of-hooks": "off" }
    }
  ],
  "ignorePatterns": [
    "dist",
    "public",
    "test-results",
    "playwright-report",
    "e2e/__screenshots__",
    "src/api/schema.d.ts",
    "src/api/openapi.json",
    "src/routeTree.gen.ts"
  ]
}
