{
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "bd prime --hook-json" },
        { "type": "command", "command": "/app/bin/hook-event session_start" }
      ]}
    ],
    "UserPromptSubmit": [ { "hooks": [ { "type": "command", "command": "/app/bin/hook-event prompt" } ] } ],
    "Stop":             [ { "hooks": [ { "type": "command", "command": "/app/bin/hook-event stop" } ] } ],
    "SubagentStart":    [ { "hooks": [ { "type": "command", "command": "/app/bin/hook-event subagent_start" } ] } ],
    "SubagentStop":     [ { "hooks": [ { "type": "command", "command": "/app/bin/hook-event subagent_stop" } ] } ],
    "SessionEnd":       [ { "hooks": [ { "type": "command", "command": "/app/bin/hook-event session_end" } ] } ]
  }
}
