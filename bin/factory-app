#!/usr/bin/env bash
# factory-app restart | build | test | status
set -euo pipefail
cd /app
case "${1:-}" in
  build)
    (cd web && npm ci --silent && npm run build)
    go generate ./... ; sqlc generate -f internal/db/sqlc.yaml
    CGO_ENABLED=0 go build -o /app/bin/server.new ./cmd/server ;;
  test)
    # the npm release-age gate (BOOTSTRAP 7): the checker and canonical .npmrc live in the read-only rules mount
    cmp -s /factory/rules/npmrc web/.npmrc || { echo "web/.npmrc differs from /factory/rules/npmrc: do not edit it" >&2; exit 1; }
    node /factory/rules/tools/check-release-age.mjs web
    go vet ./... && go test ./... ;;
  smoke)
    # Browser smoke test (BOOTSTRAP 9.12): Playwright drives the Chrome agent-browser installed.
    (cd web && npm run test:e2e) ;;
  restart)
    "$0" build && "$0" test
    mv /app/bin/server.new /app/bin/server
    s6-svc -r /run/service/app
    for i in $(seq 1 30); do curl -sf localhost:8080/healthz >/dev/null && break; sleep 1; [ "$i" = 30 ] && { echo "app did not come up; check logs: /run/service/app" >&2; exit 1; }; done
    echo "up"
    "$0" smoke ;;
  status) s6-svstat /run/service/app /run/service/claude /run/service/ttyd ;;
  *) echo "usage: factory-app build|test|smoke|restart|status" >&2; exit 2 ;;
esac
