#!/usr/bin/env bash
# playground-app restart | build | test | smoke | gate-check | status | promote <vX.Y.Z>
#   test        .npmrc and release-age checks, go vet, go test with PLAYGROUND_TEST_DATABASE_URL (default: DATABASE_URL, the
#               staging database; only a throwaway c_<uuid> schema is created and dropped) and PLAYGROUND_REQUIRE_DB=1, then
#               "contract tests: N ran, M skipped"; a contract test that cannot run FAILS (never skips). restart and gate-check run it too.
#   gate-check  rehearse the promotion gate before you tag: build the server, start it on a spare port with the
#               CANDIDATE's environment (no PLAYD_TOKEN, PLAYD_URL, STAGING_GATE_TOKEN or other platform credentials,
#               APP_ENV=production, a throwaway Postgres schema and SESSION_KEY), mint the session cookie like the gate
#               and run `npm run test:e2e` against it. Prints GATE-CHECK PASS or FAIL and exits non-zero on failure.
#               It never touches the running staging app or its data. Run it before every `playground promote` tag.
#   status      the app and agent services, then `promotion: auto|manual` (playd's promote_mode for this app; unknown when playd does not answer).
#   promote     promote the tag (already committed on main and pushed with the tag: git push origin main vX.Y.Z) to production YOURSELF.
#               Only when `status` says `promotion: auto`; on manual it refuses and you ask the orchestrator (the owner decides, only the owner
#               switches the mode). playd runs exactly the gates and steps of `playground promote` (tag on origin/main, version == tag,
#               playground-owned files, release age, secret scan, parity test, browser smoke, migrations, health) and none can be skipped. A gate that fails is
#               printed plainly and nothing changed. A promotion whose health check fails after the switch is rolled back to the previous
#               image by playd (the database is not restored; the snapshot path is in the message). Run gate-check first; the history records you as app:<name> (auto).
case "${1:-}" in -h|--help|help) sed -n '2,/^case/p' "$0" | sed '$d;s/^# \{0,1\}//'; echo "  build | test | smoke | restart | status | promote   see the script; restart = build + test + swap + smoke"; exit 0 ;; esac
set -euo pipefail
cd "${PLAYGROUND_APP_DIR:-/app}"
# playd_call METHOD PATH [BODY]: this app's own call to playd (PLAYD_URL, PLAYD_TOKEN: the app token, own app only). Sets PD_STATUS
# (HTTP code, 000 when playd does not answer) and PD_BODY. The token is never printed.
playd_call() {
  local method="$1" path="$2" body="${3-}" out
  local args=(-s -m "${PLAYD_TIMEOUT:-10}" --connect-timeout 3 -X "$method" -w $'\n%{http_code}' -H "Authorization: Bearer ${PLAYD_TOKEN:-}")
  if [ -n "$body" ]; then args+=(-H "Content-Type: application/json" --data-binary "$body"); fi
  out="$(curl "${args[@]}" "${PLAYD_URL:-http://playd:9000}$path" 2>/dev/null)" || true
  PD_STATUS="${out##*$'\n'}"
  case "$PD_STATUS" in [0-9][0-9][0-9]) ;; *) PD_STATUS=000 ;; esac
  if [[ "$out" == *$'\n'* ]]; then PD_BODY="${out%$'\n'*}"; else PD_BODY=""; fi
}
# promotion_mode: auto, manual, or unknown (no token or app name, playd silent or not answering with a mode).
promotion_mode() {
  local m=""
  if [ -n "${PLAYD_TOKEN:-}" ] && [ -n "${APP_NAME:-}" ]; then
    playd_call GET "/v1/apps/$APP_NAME"
    case "$PD_STATUS" in 2*) m="$(jq -r 'if (.promote_mode|type)=="string" then .promote_mode else "" end' <<<"$PD_BODY" 2>/dev/null || true)" ;; esac
  fi
  case "$m" in auto|manual) echo "$m" ;; *) echo unknown ;; esac
}
# promote_tag TAG: the self-promotion. playd refuses it unless the app is on auto and then runs the one promotion service.
promote_tag() {
  local tag="${1:-}" mode id rc=0 line t
  if ! [[ "$tag" =~ ^v[0-9][0-9A-Za-z._+-]{0,60}$ ]]; then echo "usage: playground-app promote vX.Y.Z (a tag already on main and pushed)" >&2; return 2; fi
  [ -n "${PLAYD_TOKEN:-}" ] && [ -n "${APP_NAME:-}" ] || { echo "promote: PLAYD_TOKEN and APP_NAME are not set; run this inside the app's agent container" >&2; return 1; }
  mode="$(promotion_mode)"
  case "$mode" in
    auto) ;;
    manual) echo "promote: refused. Promotion for $APP_NAME is MANUAL: you may not promote it yourself. Report [done] with the tag and ask the orchestrator; the owner decides (only the owner can switch this app to auto)." >&2; return 1 ;;
    *) echo "promote: refused. playd did not say which promotion mode $APP_NAME is in (unreachable or unexpected answer); treat it as MANUAL and ask the orchestrator." >&2; return 1 ;;
  esac
  playd_call POST "/v1/apps/$APP_NAME/promote" "$(jq -cn --arg t "$tag" '{tag:$t}')"
  if [ "$PD_STATUS" != 202 ]; then
    echo "promote: refused by playd ($PD_STATUS): $(jq -r '.error // empty' <<<"$PD_BODY" 2>/dev/null)" >&2
    return 1
  fi
  id="$(jq -r '.job_id // empty' <<<"$PD_BODY" 2>/dev/null)"
  [[ "$id" =~ ^[A-Za-z0-9-]{8,64}$ ]] || { echo "promote: playd did not return a job id" >&2; return 1; }
  echo "promoting $tag of $APP_NAME (job $id); the gates run first, this can take several minutes"
  local done_seen=""
  while IFS= read -r line; do
    t="$(jq -r '.t // empty' <<<"$line" 2>/dev/null)" || continue
    case "$t" in
      log) echo "  $(jq -r '.msg' <<<"$line")" ;;
      done)
        done_seen=1
        if [ "$(jq -r '.status' <<<"$line")" = ok ]; then
          echo "PROMOTED $tag: $(jq -r '.result.url // empty' <<<"$line")"
        else
          echo "PROMOTE FAILED (nothing was promoted unless the message says otherwise):" >&2
          jq -r '.error // "unknown error"' <<<"$line" >&2
          rc=1
        fi ;;
    esac
  done < <(curl -sN -m "${PROMOTE_TIMEOUT:-3000}" --connect-timeout 3 -H "Authorization: Bearer $PLAYD_TOKEN" "${PLAYD_URL:-http://playd:9000}/v1/jobs/$id" 2>/dev/null)
  [ -n "$done_seen" ] || { echo "promote: the job stream ended before the job finished; check \`playground-app status\` and the staging logs, do not retry blindly" >&2; return 1; }
  return "$rc"
}
# go_tests: go vet and go test, with the contract tests' database provided and required. PLAYGROUND_TEST_DATABASE_URL
# defaults to the app's DATABASE_URL (staging; the tests only create and drop a throwaway c_<uuid> schema); it is never
# printed. PLAYGROUND_REQUIRE_DB=1 makes a missing database a test failure, not a skip. Then it prints
# "contract tests: N ran, M skipped" from a second, verbose run of the Contract tests and fails if any was skipped.
go_tests() {
  if [ -z "${PLAYGROUND_TEST_DATABASE_URL:-}" ] && [ -n "${DATABASE_URL:-}" ]; then PLAYGROUND_TEST_DATABASE_URL=$DATABASE_URL; fi
  [ -n "${PLAYGROUND_TEST_DATABASE_URL:-}" ] && export PLAYGROUND_TEST_DATABASE_URL
  export PLAYGROUND_REQUIRE_DB=1
  go vet ./... && go test ./... || return 1
  local out rc=0 ran skipped
  out=$(mktemp "${TMPDIR:-/tmp}/contract-tests.XXXXXX")
  go test -count=1 -run Contract -v ./... >"$out" 2>&1 || rc=$?
  if [ "$rc" -ne 0 ]; then grep -v '^=== ' "$out" | tail -n 40 >&2; rm -f "$out"; echo "contract tests: FAILED" >&2; return 1; fi
  ran=$(grep -c '^--- PASS: ' "$out" || true); skipped=$(grep -c '^--- SKIP: ' "$out" || true)
  if [ "$skipped" -gt 0 ]; then grep -A2 '^--- SKIP: ' "$out" >&2; fi
  rm -f "$out"
  echo "contract tests: $ran ran, $skipped skipped"
  if [ "$skipped" -gt 0 ]; then echo "contract tests: $skipped skipped with PLAYGROUND_REQUIRE_DB=1: they must run (see docs/go-api.md)" >&2; return 1; fi
}
case "${1:-}" in
  build)
    (cd web && npm ci --silent && npm run build)
    # The CSP has no 'unsafe-eval': a bundle that generates code at runtime (Ajv's new Function) breaks in the browser.
    node /playground/rules/tools/check-no-eval.mjs web/dist
    # Staging runs the Vite dev server for HMR, but the built bundle must be a real production build: no dev-server code.
    node /playground/rules/tools/check-no-dev.mjs web/dist
    go generate ./... ; sqlc generate -f internal/db/sqlc.yaml
    v=$(git describe --tags --always --dirty 2>/dev/null || echo staging)
    CGO_ENABLED=0 go build -ldflags "-X main.version=$v" -o /app/bin/server.new ./cmd/server ;;
  test)
    # the npm release-age gate (BOOTSTRAP 7): the checker and canonical .npmrc live in the read-only rules mount
    cmp -s /playground/rules/npmrc web/.npmrc || { echo "web/.npmrc differs from /playground/rules/npmrc: do not edit it" >&2; exit 1; }
    node /playground/rules/tools/check-release-age.mjs web
    go_tests ;;
  smoke)
    # Browser smoke test (BOOTSTRAP 9.12): Playwright drives the Chrome agent-browser installed.
    # Mint a session cookie for the running app (SESSION_KEY is in the container env) so the palette, theme and
    # 390px tests run instead of skipping, and point Playwright at the Chrome agent-browser installed.
    if [ -z "${SESSION_COOKIE:-}" ]; then SESSION_COOKIE=$(go run ./cmd/mintsession) || { echo "could not mint a session cookie" >&2; exit 1; }; export SESSION_COOKIE; fi
    if [ -z "${PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH:-}" ]; then
      PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(ls -d "$HOME"/.agent-browser/browsers/chrome-*/chrome 2>/dev/null | tail -n1 || true); export PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH
    fi
    (cd web && npm run test:e2e) ;;
  gate-check)
    # Rehearsal of the promotion gate (cli/internal/appsvc/promote.go verifyCandidate): the gate runs the browser
    # smoke test against a candidate container that has NO platform credentials, so any route that needs playd, the
    # registry or another platform service must degrade to a clear "unavailable" state (not a 500/503 the smoke
    # test sees). Differences from the real gate: this runs the Go binary (not the production image), in the staging
    # container, with a throwaway schema (not a throwaway database), on localhost (not a throwaway network), and
    # skips `npm ci` when node_modules exists.
    GC=$(mktemp -d "${TMPDIR:-/tmp}/gate-check.XXXXXX")
    GC_PID=""; GC_SCHEMA=""; GC_RESULT=FAIL
    gc_cleanup() {
      [ -n "$GC_PID" ] && kill "$GC_PID" 2>/dev/null && wait "$GC_PID" 2>/dev/null || true
      if [ -n "$GC_SCHEMA" ]; then psql "$DATABASE_URL" -qAtc "DROP SCHEMA IF EXISTS $GC_SCHEMA CASCADE" >/dev/null 2>&1 || echo "gate-check: could not drop throwaway schema $GC_SCHEMA" >&2; fi
      rm -rf "$GC"
      echo "GATE-CHECK $GC_RESULT"
    }
    trap gc_cleanup EXIT
    : "${DATABASE_URL:?DATABASE_URL is not set}"
    echo "gate-check: building the server"
    (cd web && { [ -d node_modules ] || npm ci --silent; } && npm run build >/dev/null)
    node /playground/rules/tools/check-no-eval.mjs web/dist
    node /playground/rules/tools/check-no-dev.mjs web/dist
    go generate ./... ; sqlc generate -f internal/db/sqlc.yaml
    echo "gate-check: go vet and go test (the contract tests included)"
    go_tests || exit 1
    CGO_ENABLED=0 go build -ldflags "-X main.version=gate-check" -o "$GC/server" ./cmd/server
    # a spare port: the first one nothing listens on
    GC_PORT=""
    for p in $(seq 18100 18199); do (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null || { GC_PORT=$p; break; }; done
    [ -n "$GC_PORT" ] || { echo "gate-check: no spare port in 18100-18199" >&2; exit 1; }
    GC_SCHEMA="gc_$(head -c6 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    GC_KEY=$(head -c32 /dev/urandom | base64)
    psql "$DATABASE_URL" -qAtc "CREATE SCHEMA $GC_SCHEMA" >/dev/null || { GC_SCHEMA=""; echo "gate-check: cannot create a throwaway schema in the app database" >&2; exit 1; }
    case "$DATABASE_URL" in *\?*) GC_DB="$DATABASE_URL&search_path=$GC_SCHEMA" ;; *) GC_DB="$DATABASE_URL?search_path=$GC_SCHEMA" ;; esac
    # The candidate's environment: the production env minus platform credentials (gate: DATABASE_URL, SESSION_KEY and
    # MAIL_API_KEY replaced, ANTHROPIC_API_KEY and PLAYD_TOKEN removed). PLAYD_URL and the other platform variables are
    # removed too, stricter than the gate, so a route that needs the platform fails here as it would there.
    GC_ENV=(env -u PLAYD_TOKEN -u PLAYD_URL -u PLAYD_ASSERTION_KEY -u STAGING_GATE_TOKEN -u ANTHROPIC_API_KEY
      -u BEADS_DOLT_PASSWORD -u CSP_NONCE
      APP_ENV=production PORT="$GC_PORT" DATABASE_URL="$GC_DB" SESSION_KEY="$GC_KEY" MAIL_API_KEY=disabled-in-promotion-candidate)
    "${GC_ENV[@]}" "$GC/server" >"$GC/server.log" 2>&1 &
    GC_PID=$!
    echo "gate-check: candidate on 127.0.0.1:$GC_PORT (throwaway schema, no platform credentials)"
    for i in $(seq 1 60); do
      curl -sf "http://127.0.0.1:$GC_PORT/healthz" >/dev/null && break
      kill -0 "$GC_PID" 2>/dev/null || { echo "gate-check: the candidate exited; last log lines:" >&2; tail -n 15 "$GC/server.log" >&2; exit 1; }
      [ "$i" = 60 ] && { echo "gate-check: the candidate did not become healthy; last log lines:" >&2; tail -n 15 "$GC/server.log" >&2; exit 1; }
      sleep 1
    done
    # The gate mints the cookie with the candidate's SESSION_KEY: an app's own cmd/mintsession (APP_ENV=staging, as the
    # gate runs it) or the generic one.
    if [ -f cmd/mintsession/main.go ]; then
      SESSION_COOKIE=$(env -u PLAYD_TOKEN -u PLAYD_URL -u STAGING_GATE_TOKEN APP_ENV=staging SESSION_KEY="$GC_KEY" go run ./cmd/mintsession) || { echo "gate-check: could not mint a session cookie" >&2; exit 1; }
    else
      SESSION_COOKIE=""
    fi
    if [ -z "${PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH:-}" ]; then
      PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=$(ls -d "$HOME"/.agent-browser/browsers/chrome-*/chrome 2>/dev/null | tail -n1 || true)
    fi
    echo "gate-check: browser smoke test (npm run test:e2e)"
    set +e
    (cd web && env -u PLAYD_TOKEN -u PLAYD_URL -u PLAYD_ASSERTION_KEY -u STAGING_GATE_TOKEN -u ANTHROPIC_API_KEY \
      BASE_URL="http://127.0.0.1:$GC_PORT" SESSION_COOKIE="$SESSION_COOKIE" SESSION_KEY="$GC_KEY" CI=1 \
      PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH="$PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH" npm run test:e2e)
    rc=$?
    set -e
    if [ "$rc" -eq 0 ]; then GC_RESULT=PASS; else echo "gate-check: the candidate's last log lines:" >&2; tail -n 10 "$GC/server.log" >&2; fi
    exit "$rc" ;;
  restart)
    "$0" build && "$0" test
    mv /app/bin/server.new /app/bin/server
    # The app runs as the agent user, which cannot signal s6 (the control pipe is root's): stopping the old
    # process is enough, s6 respawns it and it execs the new /app/bin/server.
    pkill -u "$(id -u)" -x server || true
    sleep 1
    for i in $(seq 1 30); do curl -sf localhost:8080/healthz >/dev/null && break; sleep 1; [ "$i" = 30 ] && { echo "app did not come up; check logs: /run/service/app" >&2; exit 1; }; done
    echo "up"
    "$0" smoke ;;
  status)
    rc=0; s6-svstat /run/service/app /run/service/claude || rc=$?
    echo "promotion: $(promotion_mode)"
    exit "$rc" ;;
  promote) promote_tag "${2:-}"; exit $? ;;
  *) echo "usage: playground-app build|test|smoke|gate-check|restart|status|promote <vX.Y.Z>" >&2; exit 2 ;;
esac
