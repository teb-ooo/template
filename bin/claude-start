#!/bin/bash
# Runs inside the tmux session `agent` (started by the s6 claude service).
cd /app
mkdir -p /app/.factory
# Capture the Remote Control session URL from the start banner (verified in the phase 0 spike).
( for _ in $(seq 1 30); do
    sleep 2
    url="$(tmux capture-pane -p -J -t agent 2>/dev/null | grep -oE 'https://claude.ai/code/session_[A-Za-z0-9]+' | head -1)"
    if [ -n "$url" ]; then echo "$url" > /app/.factory/session_url; break; fi
  done ) &
# After a reboot the resumed session starts before the network is usable and shows "Remote Control disconnected";
# nothing reconnects it by itself. When the screen says so and the prompt is idle, re-enable it (the command, then
# Enter on the confirmation). Only in that state: while connected, /remote-control offers to disconnect instead.
( sleep 45
  while true; do
    pane="$(tmux capture-pane -p -J -t agent 2>/dev/null)"
    if grep -q "Remote Control disconnected" <<<"$pane" && ! grep -q "remote-control is active\|esc to interrupt" <<<"$pane" && grep -q "^❯" <<<"$pane"; then
      tmux send-keys -t agent "/remote-control"; sleep 1; tmux send-keys -t agent C-m; sleep 3; tmux send-keys -t agent C-m
      sleep 60
    fi
    sleep 20
  done ) &
claude --continue --remote-control "$APP_NAME" || claude --remote-control "$APP_NAME"
tmux wait-for -S agent-exit
