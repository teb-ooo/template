name: app-{{name}}
networks:
  app-{{name}}: { external: true }
services:
  staging:
    container_name: {{name}}-staging
    build:
      context: .
      target: staging
      args:
        CLAUDE_CODE_VERSION: "{{claude_version}}"
        AGENT_BROWSER_VERSION: "{{agent_browser_version}}"
      extra_hosts:
        - "npm-registry:${NPM_REGISTRY_BRIDGE_IP}"    # builds run on the default bridge; playd supplies the registry's bridge IP (ADR 0012)
      secrets: [netrc]
    hostname: {{name}}-staging
    env_file: /run/playground/env/{{name}}-staging.env     # written by playd to a tmpfs at start
    environment:
      APP_NAME: {{name}}
      APP_ENV: staging
      PUBLIC_URL: https://{{name}}-staging.{{domain}}
      BEADS_DOLT_SHARED_SERVER: "1"
      BEADS_DOLT_SERVER_HOST: dolt
      BEADS_DOLT_SERVER_PORT: "3306"
      BEADS_DOLT_AUTO_START: "0"
    volumes:
      - /srv/playground/apps/{{name}}:/app
      - /srv/playground/data/apps/{{name}}-staging:/data
      - /srv/playground/claude/apps/{{name}}:/home/agent/.claude
      - /srv/playground/claude/apps/{{name}}.json:/home/agent/.claude.json
      - /srv/playground/rules:/playground/brain:ro
      - /srv/playground/rules/rules:/playground/rules:ro
      - /srv/playground/data/apps/{{name}}/feedback:/playground/feedback:ro
    networks: [app-{{name}}]
    restart: unless-stopped
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    cap_add: [CHOWN, SETUID, SETGID, FOWNER, DAC_OVERRIDE]   # what s6-overlay needs; see BOOTSTRAP 4.4
    pids_limit: 2048
    mem_limit: 4g                       # includes ~400 MB for agent-browser's Chrome when in use
    cpus: "6"                           # a ceiling per container so one app cannot starve the others
    shm_size: 512m                      # Chrome needs more than Docker's 64 MB default /dev/shm
  production:
    container_name: {{name}}
    image: {{name}}:production          # built by playground promote from a tag
    user: "1000:1000"                   # the distroless image's nonroot uid cannot write the /data volume owned by the playground user
    hostname: {{name}}
    env_file: /run/playground/env/{{name}}.env
    environment:
      APP_NAME: {{name}}
      APP_ENV: production
      PUBLIC_URL: https://{{name}}.{{domain}}
    volumes:
      - /srv/playground/data/apps/{{name}}:/data
    networks: [app-{{name}}]
    restart: unless-stopped
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
    pids_limit: 256
    mem_limit: 1g
    cpus: "2"
    profiles: [production]              # not started until first promote
secrets:
  netrc: { file: /run/playground/netrc }
